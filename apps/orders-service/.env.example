# Optional live carrier directories and estimates. Keep credentials server-side.
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY=Запоріжжя
NOVA_POSHTA_SENDER_BRANCH=19
# Estimate a small box packed at the branch using DELIVERY_BOX_MAX_GRAMS.
NOVA_POSHTA_BRANCH_PACKING=false
# Optional override when the city Ref is already known.
NOVA_POSHTA_SENDER_CITY_REF=
UKRPOSHTA_BEARER=
UKRPOSHTA_TOKEN=
UKRPOSHTA_SENDER_POSTCODE=
# Use measured dimensions and weights for your checkout packaging.
DELIVERY_BOX_LENGTH_CM=
DELIVERY_BOX_WIDTH_CM=
DELIVERY_BOX_HEIGHT_CM=
DELIVERY_BOX_MAX_GRAMS=
DELIVERY_PACKAGING_GRAMS=
# Use a conservative per-unit mass for teaware in the supported parcel.
DELIVERY_PIECE_GRAMS=
