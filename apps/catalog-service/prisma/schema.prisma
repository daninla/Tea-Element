generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum CatalogSection {
 TEA
 EQUIPMENT
}

enum PromotionType {
  PERCENT
  FIXED
}

model Category {
  section CatalogSection @default(TEA)
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique @db.VarChar(100)
  name             String            @db.VarChar(150)
  description      String            @default("")
  sortOrder        Int               @default(0) @map("sort_order")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  products         Product[]
  promotionTargets PromotionTarget[]

  @@index([section, isActive])
  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  slug             String            @unique @db.VarChar(160)
  name             String            @db.VarChar(200)
  nameOriginal     String            @map("name_original") @db.VarChar(200)
  description      String
  origin           String            @db.VarChar(150)
  year             Int?
  brewingGuide     Json?              @map("brewing_guide")
  categoryId       String            @map("category_id") @db.Uuid
  images           String[]
  tags             String[]
  isActive         Boolean           @default(true) @map("is_active")
  salesCount       Int               @default(0) @map("sales_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  category         Category          @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  inventory        Inventory?
  promotionTargets PromotionTarget[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([isActive, salesCount])
  @@index([origin])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  weightGrams Int?      @map("weight_grams")
  price       Int
  sku         String   @unique @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, weightGrams])
  @@index([productId, isActive])
  @@map("product_variants")
}

model Inventory {
  stockPieces Int @default(0) @map("stock_pieces")
  reservedPieces Int @default(0) @map("reserved_pieces")
  id                     String   @id @default(uuid()) @db.Uuid
  productId              String   @unique @map("product_id") @db.Uuid
  stockGrams             Int      @default(0) @map("stock_grams")
  reservedGrams          Int      @default(0) @map("reserved_grams")
  lowStockThresholdGrams Int      @default(100) @map("low_stock_threshold_grams")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Promotion {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  type      PromotionType
  value     Int
  startsAt  DateTime          @map("starts_at")
  endsAt    DateTime          @map("ends_at")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  targets   PromotionTarget[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model PromotionTarget {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @map("promotion_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@unique([promotionId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("promotion_targets")
}

model Outbox {
  id            String    @id @db.Uuid
  eventName     String    @map("event_name")
  payload       Json
  correlationId String    @map("correlation_id")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox")
}

model ProcessedEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("processed_events")
}

model StockReservation {
 id String @id @default(uuid()) @db.Uuid
 orderId String @unique @map("order_id") @db.Uuid
 status String
 items Json
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@map("stock_reservations")
}
