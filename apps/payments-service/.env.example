NODE_ENV=development
PORT=4004
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgresql://payments:tea_dev_payments@localhost:5433/payments_db
RABBITMQ_URL=amqp://tea:tea_dev@localhost:5672
REDIS_URL=redis://localhost:6379
PAYMENT_PROVIDER=fake
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Sandbox adapters only in stage 4a.1; no gateway webhook route exists yet.
# For PAYMENT_PROVIDER=liqpay, use sandbox_ keys and HTTPS callback/storefront origins.
# PAYMENT_CALLBACK_URL=https://your-api.example/api/v1/payments/webhook/liqpay
PAYMENTS_RPC_QUEUE=payments.rpc
ORDERS_RPC_QUEUE=orders.rpc
EVENTS_NAMESPACE=tea
# Optional persistent simulator signing key, dev/test only; do not commit real secrets.
# FAKE_PAYMENT_SECRET=generate-a-private-random-value-of-at-least-32-characters
