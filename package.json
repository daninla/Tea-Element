{
  "name": "tea-element",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/setup-auth-env.mjs && turbo dev",
    "build": "turbo build",
    "lint": "eslint scripts *.mjs && turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "health": "node scripts/check-health.mjs",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @tea/auth-service db:migrate && pnpm --filter @tea/catalog-service db:migrate && pnpm --filter @tea/orders-service db:migrate",
    "seed:admin": "pnpm --filter @tea/auth-service seed:admin",
    "test:integration": "node scripts/test-auth-integration.mjs && node scripts/test-catalog-integration.mjs && node scripts/test-orders-integration.mjs",
    "setup:dev": "node scripts/setup-auth-env.mjs",
    "db:seed": "pnpm seed:admin && pnpm --filter @tea/catalog-service db:seed",
    "test:catalog:integration": "node scripts/test-catalog-integration.mjs",
    "test:orders:integration": "node scripts/test-orders-integration.mjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "typescript": "^5.9.0",
    "turbo": "^2.5.0",
    "prettier": "^3.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.0.0",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md,css}": "prettier --write"
  }
}
