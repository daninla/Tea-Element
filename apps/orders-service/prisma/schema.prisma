generator client {
 provider = "prisma-client-js"
 output = "../generated/prisma"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}
enum OrderStatus {
 PENDING
 CONFIRMED
 AWAITING_PAYMENT
 PAID
 REJECTED
 CANCELLED
 SHIPPED
 COMPLETED
}
model Order {
 id String @id @default(uuid()) @db.Uuid
 number String @unique
 userId String? @map("user_id") @db.Uuid
 status OrderStatus @default(PENDING)
 items Json
 subtotal Int
 discount Int
 total Int
 firstName String @map("customer_first_name")
 lastName String @map("customer_last_name")
 email String @map("customer_email")
 phone String @map("customer_phone")
 delivery Json
 paymentMethod String @default("CASH_ON_DELIVERY") @map("payment_method")
 paymentAttemptId String? @map("payment_attempt_id") @db.Uuid
 paymentExpiresAt DateTime? @map("payment_expires_at")
 stockDeductedAt DateTime? @map("stock_deducted_at")
 paymentStatus String @default("UNPAID") @map("payment_status")
 comment String @default("")
 marketingConsentAt DateTime? @map("marketing_consent_at")
 termsAcceptedAt DateTime @default(now()) @map("terms_accepted_at")
 accessTokenHash String @map("access_token_hash") @db.Char(64)
 tokenNonce String @map("token_nonce")
 idempotencyHash String @unique @map("idempotency_hash") @db.Char(64)
 requestHash String @map("request_hash") @db.Char(64)
 reservationExpiresAt DateTime @map("reservation_expires_at")
 lookupRequestedAt DateTime? @map("lookup_requested_at")
 receiptSentAt DateTime? @map("receipt_sent_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 history OrderStatusHistory[]
 paymentNotices OrderPaymentNotice[]
 @@index([userId, createdAt])
 @@index([email,createdAt])
 @@index([status, reservationExpiresAt])
 @@index([receiptSentAt])
 @@index([status,paymentExpiresAt])
 @@map("orders")
}
model OrderPaymentNotice {
 id String @id @default(uuid()) @db.Uuid
 orderId String @map("order_id") @db.Uuid
 paymentId String? @map("payment_id") @db.Uuid
 dedupeKey String? @unique @map("dedupe_key")
 kind String
 amount Int
 currency String @default("UAH")
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
 leaseId String? @map("lease_id") @db.Uuid
 leaseUntil DateTime? @map("lease_until")
 sentAt DateTime? @map("sent_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 @@unique([paymentId,kind])
 @@index([status,nextAttemptAt,leaseUntil])
 @@index([orderId,createdAt])
 @@map("order_payment_notices")
}
model OrderStatusHistory {
 id String @id @default(uuid()) @db.Uuid
 orderId String @map("order_id") @db.Uuid
 status OrderStatus
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 @@index([orderId, createdAt])
 @@map("order_status_history")
}
model Cart {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @map("user_id") @db.Uuid
 items Json
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@map("carts")
}
model Outbox {
  id            String    @id @db.Uuid
  eventName     String    @map("event_name")
  payload       Json
  correlationId String    @map("correlation_id")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox")
}

model ProcessedEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("processed_events")
}

model CartMerge {
 id String @id @default(uuid()) @db.Uuid
 userId String @map("user_id") @db.Uuid
 key String @db.Uuid
 fingerprint String @db.Char(64)
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([userId, key])
 @@map("cart_merges")
}

model PaymentAttempt {
 id String @id @db.Uuid
 orderId String @map("order_id") @db.Uuid
 status String @default("PENDING")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([orderId,createdAt])
 @@map("payment_attempts")
}
model PaymentCommand {
 id String @id @default(uuid()) @db.Uuid
 orderId String @map("order_id") @db.Uuid
 key String @db.Uuid
 action String
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([orderId,key])
 @@map("payment_commands")
}

model VerifiedIdentity {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @map("user_id") @db.Uuid
 email String @unique
 verifiedAt DateTime @map("verified_at")
 lastLinkedAt DateTime @default(now()) @map("last_linked_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([lastLinkedAt])
 @@map("verified_identities")
}

model AdminOrderCommand {
 id String @id @default(uuid()) @db.Uuid
 orderId String @map("order_id") @db.Uuid
 key String @db.Uuid
 actorId String @map("actor_id") @db.Uuid
 fromStatus OrderStatus @map("from_status")
 status OrderStatus
 reason String
 fingerprint String @db.Char(64)
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@unique([orderId,key])
 @@index([orderId,createdAt])
 @@map("admin_order_commands")
}
