generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique @db.VarChar(320)
  passwordHash       String         @map("password_hash")
  firstName          String         @map("first_name") @db.VarChar(100)
  lastName           String         @map("last_name") @db.VarChar(100)
  phone              String?        @db.VarChar(16)
  role               Role           @default(CUSTOMER)
  isActive           Boolean        @default(true) @map("is_active")
  emailVerifiedAt    DateTime?      @map("email_verified_at")
  defaultDelivery    Json?          @map("default_delivery")
  marketingConsentAt DateTime?      @map("marketing_consent_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  refreshTokens      RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(256)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Outbox {
  id            String    @id @db.Uuid
  eventName     String    @map("event_name")
  payload       Json
  correlationId String    @map("correlation_id")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt, nextAttemptAt])
  @@map("outbox")
}

model ProcessedEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("processed_events")
}
