{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "generated/**"],
      "env": ["NEXT_PUBLIC_API_URL", "INTERNAL_API_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "JWT_ACCESS_SECRET",
        "AUTH_RPC_QUEUE",
        "DATABASE_URL",
        "RABBITMQ_URL",
        "NODE_ENV",
        "EVENTS_NAMESPACE",
        "PORT"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
