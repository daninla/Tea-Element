{
  "name": "@tea/orders-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && pnpm --dir ../.. exec nest start orders-service --watch",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && jest --runInBand",
    "prisma": "prisma",
    "db:migrate": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@tea/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0",
    "dotenv": "^16.6.0",
    "nestjs-pino": "^4.4.0",
    "pino-http": "^10.5.0",
    "pino": "^9.9.0",
    "helmet": "^8.1.0",
    "@nestjs/microservices": "^11.2.8",
    "@prisma/client": "6.19.3",
    "amqplib": "^0.10.9",
    "amqp-connection-manager": "^4.1.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@tea/tsconfig": "workspace:*",
    "@tea/eslint-config": "workspace:*",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "prisma": "6.19.3",
    "@types/amqplib": "^0.10.7",
    "@types/nodemailer": "^7.0.0"
  }
}
